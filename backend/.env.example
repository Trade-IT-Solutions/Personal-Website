# Stripe (use Dashboard → Developers → Webhooks → signing secret)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_15_MIN=price_1TH5RaEoPlVeWCJv8npkipNQ
STRIPE_PRICE_30_MIN=price_1TH5PaEoPlVeWCJvGsiOY79X
STRIPE_PRICE_60_MIN=price_1TH5QVEoPlVeWCJveHKq584U

# Public site (success/cancel redirects for Checkout)
PUBLIC_SITE_URL=https://www.kellyohgee.com

# Slack — Incoming Webhook URL (optional). Sent after Stripe webhook creates Meet + email.
# https://api.slack.com/messaging/webhooks — pick channel → copy webhook URL.
SLACK_BOOKING_WEBHOOK_URL=

# Google Calendar — service account + Calendar API enabled in GCP.
#
# Workspace domain-wide delegation (no calendar sharing):
# 1. In GCP: service account → Enable domain-wide delegation; note the numeric Client ID
#    (e.g. 111407700303807447262) — that ID + scope go in Admin Console only, not in .env
# 2. In admin.google.com: Security → API controls → Domain-wide delegation → Add the Client ID
#    with scope: https://www.googleapis.com/auth/calendar
# 3. Set GOOGLE_CALENDAR_IMPERSONATE to Kelly's real Workspace email (the user to impersonate).
# 4. Use GOOGLE_CALENDAR_ID=primary unless you target another calendar of that user.
GOOGLE_SERVICE_ACCOUNT_EMAIL=calendar-automation@one-on-one-with-kelly.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY=
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_IMPERSONATE=kelly@YOUR_WORKSPACE_DOMAIN.com

# Booking window (optional)
BOOKING_TIMEZONE=America/New_York
BOOKING_START_HOUR=9
BOOKING_END_HOUR=17
BOOKING_MIN_LEAD_HOURS=4

# SendGrid (existing)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
ADMIN_EMAIL=
