# ============================================
# SMTP Email Configuration
# ============================================

SMTP_HOST=smtp.gmail.com


SMTP_PORT=587

# Your email address (will be used as the sender)
SMTP_USER=contact@kellyohgee.info

# Your email password or app-specific password
# For Gmail: Use App Password (not your regular password)
# For Outlook: Use your regular password or App Password
# For custom domain: Your email password
SMTP_PASSWORD=fltw zmul felf ahdx

# ============================================
# Email Settings
# ============================================

# Name that appears as the sender
FROM_NAME=Team Kelly Ohgee

# Email address to receive download notifications
# Can be the same as SMTP_USER or different
ADMIN_EMAIL=contact@kellyohgee.info

# ============================================
# Server Configuration
# ============================================

# Port number for the backend server to run on
PORT=5001

# Environment mode
# Use "development" for local testing, "production" for live site
NODE_ENV=production